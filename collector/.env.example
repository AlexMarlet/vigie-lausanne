# Telegram — clés API sur https://my.telegram.org (API development tools)
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# Généré par : python collector.py --login   (garde-le secret, il donne accès à ton compte)
TG_SESSION=
# Groupe ou canal à lire (tu dois en être membre) : l'ID affiché par  python collector.py --list
# (ex. -1001234567890), ou @nom / lien t.me/... si le groupe est public
TG_CHANNEL=

# Supabase — URL : bouton « Connect » du projet (https://<id-du-projet>.supabase.co)
SUPABASE_URL=https://xxxx.supabase.co
# Clé secrète (sb_secret_…) : Settings > API Keys. Ne jamais la mettre dans l'app.
SUPABASE_SECRET_KEY=
# Sel secret pour l'empreinte anonyme des messages (n'importe quelle chaîne longue)
VIGIE_SALT=remplace-moi-par-une-longue-chaine-aleatoire
# Fenêtre de rattrapage au démarrage (minutes)
VIGIE_BACKFILL_MIN=120
